from collections import *

def solution(cacheSize, cities):
    if cacheSize == 0:
        return len(cities) * 5
        
    # maxlen을 설정하면 append 시 자동으로 왼쪽 요소가 탈락됨 (Miss일 때 편리)
    cache = deque(maxlen=cacheSize)
    time = 0
    
    for city in cities:
        city = city.lower()
        if city in cache:
            cache.remove(city)
            cache.append(city)
            time += 1
        else:
            cache.append(city) # maxlen 덕분에 pop(0) 코드가 필요 없음
            time += 5
            
    return time
